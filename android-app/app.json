{
  "expo": {
    "name": "Monetra",
    "slug": "monetra-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "monetra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      "expo-sqlite"
    ],
    "android": {
      "package": "com.flickscient.monetra.native",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#173e30"
      },
      "edgeToEdgeEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}