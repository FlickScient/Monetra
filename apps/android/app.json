{
  "expo": {
    "name": "Monetra",
    "slug": "monetra",
    "scheme": "monetra",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.flickscient.monetra",
      "versionCode": 2,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F4F3EC"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      ["expo-sqlite", { "useSQLCipher": true }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}